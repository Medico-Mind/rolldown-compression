{
  "name": "@medicomind/rolldown-compression",
  "version": "2.6.3",
  "description": "Fast native (Rust) gzip / brotli / zstd compression plugin for Rolldown, powered by napi-rs",
  "keywords": [
    "rolldown",
    "rolldown-plugin",
    "vite",
    "vite-plugin",
    "compression",
    "compress",
    "gzip",
    "brotli",
    "zstd",
    "zstandard",
    "rust",
    "native",
    "napi-rs",
    "performance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Medico-Mind/rolldown-compression.git"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.js",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">= 22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "binaryName": "rolldown-compression",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node benchmark/index.mjs",
    "bench:pgo": "node benchmark/pgo-compare.mjs",
    "changeset": "changeset",
    "build": "napi build --platform --release && npm run build:ts",
    "build:debug": "napi build --platform && npm run build:ts",
    "build:native": "napi build --platform --release",
    "build:pgo": "node scripts/pgo/build.mjs",
    "build:ts": "tsdown",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepublishOnly": "napi prepublish -t npm",
    "tag-release": "changeset git-tag && git push origin --tags",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "universalize": "napi universalize",
    "version-packages": "changeset version && napi version && npm install --package-lock-only"
  },
  "peerDependencies": {
    "rolldown": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@emnapi/core": "2.0.0-beta.3",
    "@emnapi/runtime": "2.0.0-beta.3",
    "@napi-rs/cli": "^3.10.12",
    "@napi-rs/wasm-runtime": "^1.2.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "emnapi": "2.0.0-beta.3",
    "rolldown": "^1.2.16",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
